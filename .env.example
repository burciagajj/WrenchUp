# Expo app
# Optional local testing override. Set to MX or US; leave unset in production.
EXPO_PUBLIC_TEST_REGION=
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Live publishable key. Only ever used in a real production build — dev builds
# (including Expo Go) ignore this and always fall back to the test key above.
# Get this from https://dashboard.stripe.com/apikeys with "Viewing live data" ON.
EXPO_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
# Legacy alias supported by the app, but keep it test-only if you use it.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Optional: force mock payments in local dev builds. Expo Go and web dev auto-mock.
EXPO_PUBLIC_ENABLE_MOCK_PAYMENTS=true
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal.example
EXPO_PUBLIC_OAUTH_SERVER_URL=https://your-oauth-server.example
EXPO_PUBLIC_APP_ID=your_app_id
EXPO_PUBLIC_OWNER_OPEN_ID=your_owner_open_id
EXPO_PUBLIC_OWNER_NAME=Your Name
# Optional: shown to users when they need to reach support (e.g. name change requests).
EXPO_PUBLIC_SUPPORT_EMAIL=support@wrenchup.app

# Server-only secrets. Never prefix these with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Stripe secret key used by app/api/payment-intent, payment-verify, and
# payment-capture-sweep. Use a pk_test_-matching sk_test_ key for dev/staging
# and an sk_live_ key (from https://dashboard.stripe.com/apikeys with
# "Viewing live data" ON) for production. Whatever you set here is what the
# server actually charges against — there's no separate dev/prod switch,
# so double-check this before deploying.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Signing secret for the Stripe webhook (app/api/stripe-webhook+api.ts). Get
# this from the Stripe Dashboard after registering the webhook endpoint URL
# (Developers > Webhooks > Add endpoint, subscribed to at least account.updated).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Shared secret for scheduled/service-to-service calls (e.g. the Supabase pg_cron
# job that hits /api/payment-capture-sweep). Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=your_cron_secret
ADMIN_USER_EMAIL=admin@example.com
# Optional: mirror ADMIN_USER_EMAIL for client-side admin route gate (Expo public env).
EXPO_PUBLIC_ADMIN_EMAIL=admin@example.com
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
OAUTH_SERVER_URL=https://ftvbmpajwocikjqxwbao.supabase.co
# Read at build/prebuild time by app.config.ts (android.config.googleMaps.apiKey) —
# NOT a runtime client var, so no EXPO_PUBLIC_ prefix. Without this, react-native-maps
# renders blank on Android (no Apple Maps fallback there). Get one at
# https://console.cloud.google.com/google/maps-apis with "Maps SDK for Android"
# enabled, restricted to this app's package name + release signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_api_key
